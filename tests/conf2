"""
Fixtures de pytest con soporte multi-navegador.
Chrome, Edge y Firefox en modo headless (sin ventana visible).
"""
import pytest
from selenium import webdriver
from selenium.webdriver.chrome.options import Options as ChromeOptions
from selenium.webdriver.edge.options import Options as EdgeOptions
from selenium.webdriver.firefox.options import Options as FirefoxOptions


def _chrome():
    opts = ChromeOptions()
    opts.add_argument("--headless=new")
    opts.add_argument("--window-size=1920,1080")
    opts.add_argument("--lang=es-ES")
    opts.add_argument("--disable-gpu")
    opts.add_argument("--no-sandbox")
    return webdriver.Chrome(options=opts)


def _edge():
    opts = EdgeOptions()
    opts.add_argument("--headless=new")
    opts.add_argument("--window-size=1920,1080")
    opts.add_argument("--lang=es-ES")
    opts.add_argument("--disable-gpu")
    opts.add_argument("--no-sandbox")
    return webdriver.Edge(options=opts)


def _firefox():
    opts = FirefoxOptions()
    opts.add_argument("--headless")
    opts.add_argument("--width=1920")
    opts.add_argument("--height=1080")
    return webdriver.Firefox(options=opts)


NAVEGADORES = {
    "chrome":  _chrome,
    "edge":    _edge,
    "firefox": _firefox,
}


@pytest.fixture(params=list(NAVEGADORES.keys()))
def driver(request):
    """Crea el navegador indicado por el parámetro, headless."""
    fabrica = NAVEGADORES[request.param]
    driver = fabrica()
    yield driver
    driver.quit()